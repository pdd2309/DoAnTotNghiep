@{
    ViewData["Title"] = "Cửa Hàng Công Nghệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="breadcrumb-section" style="background-color: #7fad39; padding: 20px 0;">
    <div class="container text-center">
        <h2 style="color: white;">Cửa Hàng Công Nghệ</h2>
    </div>
</section>

<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-5">
                <div class="sidebar">
                    @* Ô tìm kiếm tại Shop *@
                    <div class="sidebar__item">
                        <h4>Tìm Kiếm</h4>
                        <div class="sidebar__item__search" style="position: relative;">
                            <form action="/Home/Shop" method="get">
                                <input type="text" name="searchString" placeholder="Tìm máy..."
                                       value="@Context.Request.Query["searchString"]"
                                       style="width: 100%; height: 45px; border: 1px solid #ebebeb; padding-left: 15px;">
                                <button type="submit" style="position: absolute; right: 10px; top: 10px; border: none; background: none;">
                                    <i class="fa fa-search"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    @* Danh mục đổ từ API *@
                    <div class="sidebar__item">
                        <h4>Danh Mục</h4>
                        <ul id="category-list-shop">
                            <li><p>Đang tải danh mục...</p></li>
                        </ul>
                    </div>

                    <div class="sidebar__item">
                        <h4>Giá</h4>
                        <div class="price-range-wrap">
                            <div class="price-range ui-slider ui-corner-all ui-slider-horizontal ui-widget ui-widget-content"
                                 data-min="10" data-max="1000">
                                <div class="ui-slider-range ui-corner-all ui-widget-header"></div>
                                <span tabindex="0" class="ui-slider-handle ui-corner-all ui-state-default"></span>
                                <span tabindex="0" class="ui-slider-handle ui-corner-all ui-state-default"></span>
                            </div>
                            <div class="range-slider">
                                <div class="price-input" style="display:flex; gap:8px; align-items:center;">
                                    @* Thêm style để ẩn nút tăng giảm trực tiếp vào input *@
                                    <input type="number" id="minamount" min="0" step="1000" placeholder="Từ"
                                           style="max-width: 100px; -moz-appearance: textfield; appearance: none; border: 1px solid #ebebeb; padding-left: 10px; height: 40px;">

                                    <input type="number" id="maxamount" min="0" step="1000" placeholder="Đến"
                                           style="max-width: 100px; -moz-appearance: textfield; appearance: none; border: 1px solid #ebebeb; padding-left: 10px; height: 40px;">

                                    <button type="button" id="apply-price-filter" class="site-btn"
                                            style="padding:8px 14px; font-size:12px; background-color: #7fad39; border: none; color: white; height: 40px;">
                                        Lọc
                                    </button>
                                </div>
                            </div>

                            <style>
                                /* Đoạn này để xử lý triệt để trên Chrome, Safari, Edge và Opera */
                                #minamount::-webkit-outer-spin-button,
                                #minamount::-webkit-inner-spin-button,
                                #maxamount::-webkit-outer-spin-button,
                                #maxamount::-webkit-inner-spin-button {
                                    -webkit-appearance: none;
                                    margin: 0;
                                }
                            </style>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-9 col-md-7">
                <div class="filter__item">
                    <div class="row">
                        <div class="col-lg-6 col-md-6">
                            <div class="filter__found">
                                <h6>Tìm Thấy <span id="product-count">0</span> Sản Phẩm</h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" id="product-list-shop">
                    <div class="col-12 text-center"><p>Đang tải sản phẩm...</p></div>
                </div>
                <div class="product__pagination" id="shop-pagination"></div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="/js/fetch-products-shop.js"></script>
}